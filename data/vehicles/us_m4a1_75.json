  "_meta": {
    "status": "reviewed",
    "unverified": [],
    "deviation_reason": {
      "gameplay.max_speed_mps": "Game top speed = 0.75 × historical road speed (24 mph = 10.72896 m/s → 8.04672 m/s, GAMEDESIGN §14.3).",
      "gameplay.seats": "3 gameplay crew seats (driver, gunner, commander) vs historical 5-man crew (loader and bow MG operator omitted per GAMEDESIGN §14.1/§14.3).",
      "gameplay.armor_zones": "Plate thicknesses match TM 9-2800 p. 109 (hull front 2 in = 51 mm, side/rear 1.5 in = 38 mm, top 3/4 in = 19 mm; turret front 3 in = 76 mm, side/rear 2 in = 51 mm, top 1 in = 25 mm). Slopes use single representative game angles per zone (GAMEDESIGN §14.3.3: hull upper 56° vs cast 37°–55° / welded 56°, lower 45° vs curved 0°–45°, turret front 30°, turret side/rear 25° game nominal vs historical 5°/0°).",
      "gameplay.weapons": "75 mm M3 shells correspond to M61 APCBC (TM 9-1901 §87/§89: MV 2,030 ft/s = 619 m/s; p100_mm = 82 is game nominal penetration per GAMEDESIGN §0.4/§14.4), M48 HE (TM 9-1901 §94–95: historical MV 1,974 ft/s = 602 m/s supercharge / 1,515 ft/s = 462 m/s normal, unified to 619 m/s in gameplay), and M64 WP Smoke (TM 9-1901 §107: historical MV 1,980 ft/s = 604 m/s, unified to 619 m/s). Stowage (30 AP / 24 HE / 6 WP = 60 vs historical 90; .30 cal M1919A4 1,000 + 400 vs 4,750; .50 cal M2HB 200 vs 300) and reload_s = 3.0 are gameplay balance parameters (GAMEDESIGN §14.3)."
    },
