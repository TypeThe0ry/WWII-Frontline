{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontline.invalid/schemas/bots.schema.json",
  "title": "Bot difficulty and behaviour tuning (GAMEDESIGN 20.6, ARCHITECTURE 16.3, M0-026); data/rules/bots.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["default_difficulty", "difficulties", "think_interval_ms", "perception", "nav", "combat", "stuck", "_meta"],
  "$defs": {
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction_ms", "aim_error_mult", "memory_s", "view_distance_m"],
      "properties": {
        "reaction_ms": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 5000 }
        },
        "aim_error_mult": { "type": "number", "minimum": 0, "maximum": 10 },
        "memory_s": { "type": "number", "minimum": 0, "maximum": 60 },
        "view_distance_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    }
  },
  "properties": {
    "default_difficulty": { "enum": ["recruit", "regular", "veteran"] },
    "difficulties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recruit", "regular", "veteran"],
      "properties": {
        "recruit": { "$ref": "#/$defs/difficulty" },
        "regular": { "$ref": "#/$defs/difficulty" },
        "veteran": { "$ref": "#/$defs/difficulty" }
      }
    },
    "think_interval_ms": { "type": "number", "minimum": 33, "maximum": 1000 },
    "perception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fov_deg", "view_distance_cap_m", "min_recognition_mult"],
      "properties": {
        "fov_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
        "view_distance_cap_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "min_recognition_mult": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_size_m", "max_slope_deg", "goal_radius_m", "repath_min_interval_ms"],
      "properties": {
        "cell_size_m": { "type": "number", "minimum": 1, "maximum": 16 },
        "max_slope_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "goal_radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "repath_min_interval_ms": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind_fire_max_m", "turn_rate_deg_s", "aim_error_base_deg", "aim_error_per_100m_deg", "fire_tolerance_deg", "crouch_min_m", "sprint_min_m"],
      "properties": {
        "blind_fire_max_m": { "type": "number", "minimum": 0, "maximum": 1000 },
        "turn_rate_deg_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 8000 },
        "aim_error_base_deg": { "type": "number", "minimum": 0, "maximum": 10 },
        "aim_error_per_100m_deg": { "type": "number", "minimum": 0, "maximum": 10 },
        "fire_tolerance_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 45 },
        "crouch_min_m": { "type": "number", "minimum": 0, "maximum": 1000 },
        "sprint_min_m": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    },
    "stuck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_s", "min_move_m"],
      "properties": {
        "window_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "min_move_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 }
      }
    },
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tunable"],
      "properties": {
        "status": { "enum": ["initial", "reviewed", "measured"] },
        "tunable": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "calibration_ref": { "type": ["string", "null"] }
      }
    }
  }
}
