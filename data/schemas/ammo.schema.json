{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontline.invalid/schemas/ammo.schema.json",
  "title": "Ammunition (GAMEDESIGN 6.4, 6.7, 8.1; M1-008b)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_key",
    "historical",
    "gameplay",
    "_meta"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/slug"
    },
    "name_key": {
      "$ref": "#/$defs/i18n_key"
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caliber",
        "mass_kg",
        "_source"
      ],
      "properties": {
        "caliber": {
          "type": "string",
          "minLength": 1
        },
        "mass_kg": {
          "$ref": "#/$defs/pos"
        },
        "_source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drag_k_per_m",
        "pen_power",
        "suppression_mult"
      ],
      "properties": {
        "drag_k_per_m": {
          "$ref": "#/$defs/nonneg"
        },
        "pen_power": {
          "$ref": "#/$defs/nonneg"
        },
        "suppression_mult": {
          "$ref": "#/$defs/nonneg"
        }
      }
    },
    "_meta": {
      "$ref": "#/$defs/meta"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "i18n_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "pos": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonneg": {
      "type": "number",
      "minimum": 0
    },
    "unit01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "tunable"
      ],
      "properties": {
        "status": {
          "enum": [
            "initial",
            "reviewed",
            "measured"
          ]
        },
        "tunable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "calibration_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deviation_reason": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      ]
    }
  }
}
