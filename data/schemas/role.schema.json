{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontline.invalid/schemas/role.schema.json",
  "title": "Role (ARCHITECTURE 8.5.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name_key", "faction_overrides", "movement", "health_hp", "_meta"],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "name_key": { "$ref": "#/$defs/i18n_key" },
    "faction_overrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "us": { "$ref": "#/$defs/faction_override" },
        "ger": { "$ref": "#/$defs/faction_override" }
      }
    },
    "max_per_squad": { "type": ["integer", "null"], "minimum": 0 },
    "max_per_team": { "type": ["integer", "null"], "minimum": 0 },
    "unlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["squad_size_min", "requires_squad_leader"],
      "properties": {
        "squad_size_min": { "type": "integer", "minimum": 0 },
        "requires_squad_leader": { "type": "boolean" }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walk_mps", "run_mps", "sprint_mps", "crouch_mps", "prone_mps", "stamina_max"],
      "properties": {
        "walk_mps": { "type": "number" },
        "run_mps": { "type": "number" },
        "sprint_mps": { "type": "number" },
        "crouch_mps": { "type": "number" },
        "prone_mps": { "type": "number" },
        "stamina_max": { "type": "number", "exclusiveMinimum": 0 },
        "crouch_walk_mps": { "type": "number" },
        "jump_height_m": { "type": "number", "exclusiveMinimum": 0 },
        "stance_transition_ms": { "type": "number", "exclusiveMinimum": 0 },
        "air_control_mult": { "type": "number", "minimum": 0, "maximum": 1 },
        "gravity_mps2": { "type": "number", "exclusiveMinimum": 0 },
        "max_slope_deg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90 },
        "autostep_max_m": { "type": "number", "minimum": 0 },
        "autostep_min_width_m": { "type": "number", "minimum": 0 },
        "snap_to_ground_m": { "type": "number", "minimum": 0 },
        "accel_time_s": { "type": "number", "minimum": 0 },
        "decel_time_s": { "type": "number", "minimum": 0 },
        "prone_fast_mps": { "type": "number", "exclusiveMinimum": 0 },
        "prone_fast_cost_per_s": { "type": "number", "exclusiveMinimum": 0 },
        "crouch_to_prone_ms": { "type": "number", "exclusiveMinimum": 0 },
        "prone_to_crouch_ms": { "type": "number", "exclusiveMinimum": 0 },
        "stand_to_prone_ms": { "type": "number", "exclusiveMinimum": 0 },
        "prone_to_stand_ms": { "type": "number", "exclusiveMinimum": 0 },
        "ads_stand_mult": { "type": "number", "minimum": 0 },
        "ads_crouch_mult": { "type": "number", "minimum": 0 },
        "ads_prone_mult": { "type": "number", "minimum": 0 },
        "reload_move_mult": { "type": "number", "minimum": 0 },
        "crawl_mps": { "type": "number", "exclusiveMinimum": 0 },
        "load_ref_kg": { "type": "number", "minimum": 0 },
        "load_penalty_per_kg": { "type": "number", "minimum": 0 },
        "load_min_mult": { "type": "number", "minimum": 0 },
        "sprint_cost_per_s": { "type": "number", "exclusiveMinimum": 0 },
        "stamina_regen_per_s": { "type": "number", "exclusiveMinimum": 0 },
        "stamina_regen_delay_s": { "type": "number", "exclusiveMinimum": 0 },
        "stamina_regen_crouch_mult": { "type": "number", "minimum": 0 },
        "stamina_regen_prone_mult": { "type": "number", "minimum": 0 },
        "stamina_low_points": { "type": "number", "minimum": 0 },
        "stamina_unlock_points": { "type": "number", "minimum": 0 },
        "jump_cost_points": { "type": "number", "minimum": 0 },
        "stance_recoil_crouch_mult": { "type": "number", "minimum": 0 },
        "stance_recoil_prone_mult": { "type": "number", "minimum": 0 },
        "stance_spread_crouch_mult": { "type": "number", "minimum": 0 },
        "stance_spread_prone_mult": { "type": "number", "minimum": 0 },
        "visibility_crouch_mult": { "type": "number", "minimum": 0 },
        "visibility_prone_mult": { "type": "number", "minimum": 0 },
        "hitbox_height_stand_m": { "type": "number", "minimum": 0 },
        "hitbox_height_crouch_m": { "type": "number", "minimum": 0 },
        "hitbox_height_prone_m": { "type": "number", "minimum": 0 },
        "move_spread_walk_mult": { "type": "number", "minimum": 0 },
        "move_spread_run_mult": { "type": "number", "minimum": 0 }
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius_m", "height_stand_m", "height_crouch_m"],
      "properties": {
        "radius_m": { "type": "number", "exclusiveMinimum": 0 },
        "height_stand_m": { "type": "number", "exclusiveMinimum": 0 },
        "height_crouch_m": { "type": "number", "exclusiveMinimum": 0 },
        "eye_height_stand_m": { "type": "number", "exclusiveMinimum": 0 },
        "eye_height_crouch_m": { "type": "number", "exclusiveMinimum": 0 },
        "height_prone_m": { "type": "number", "exclusiveMinimum": 0 },
        "eye_height_prone_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "health_hp": { "type": "number", "exclusiveMinimum": 0 },
    "abilities": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
    "icon_id": { "type": "string", "minLength": 1 },
    "manpower_cost": { "type": "integer", "minimum": 0 },
    "_meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
    "i18n_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
    "faction_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadout_ids"],
      "properties": { "loadout_ids": { "type": "array", "items": { "$ref": "#/$defs/slug" } } }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tunable"],
      "properties": {
        "status": { "enum": ["initial", "reviewed", "measured"] },
        "tunable": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "calibration_ref": { "type": ["string", "null"] }
      }
    }
  }
}
