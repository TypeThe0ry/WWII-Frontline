{
  "name": "@frontline/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync-map": "node scripts/sync-map.mjs",
    "dev": "node scripts/sync-map.mjs && vite",
    "build": "node scripts/sync-map.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "i18n:check": "node src/ui/i18n/check-cli.mjs",
    "variant-count": "vitest run src/render/materials/variants.test.ts --disableConsoleIntercept",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "@preact/signals": "2.11.4",
    "meshoptimizer": "1.3.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
