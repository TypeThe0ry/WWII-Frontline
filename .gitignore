# Rust
target/
*.pdb

# Node
node_modules/
dist/

# Assets (manual, not in git; manifests are tracked elsewhere)
assets/incoming/
assets/processed/
docs/measurements/raw/

# Misc
.DS_Store
*.log
__pycache__/
.venv/

# M0-009: generated map binaries (deterministic; regenerate with the command in DEVELOPING.md)
data/maps/m0/*.r16
data/maps/m0/chunks/

# M0-023: map binaries copied for the dev server / build by client/scripts/sync-map.mjs
client/public/maps/
client/public/wasm/
# Playwright output
client/test-results/
client/playwright-report/

# M0-017: WebTransport development certificate (generate with tools/dev/gen-dev-cert.sh)
/dev-cert/
dev-cert*.pem
dev-key*.pem

# M0-032: private analysis scratch (frames, extracted audio) — recordings themselves live in raw/ or ref-captures/
docs/measurements/frames/
docs/measurements/tmp/

# M1-001: asset-pipeline intermediate products (work/{asset_id}/raw, normalized.gltf ...)
/work/

# M1-065a: generated font subsets (python3 tools/font-subset/subset.py --fetch --src assets/incoming/fonts --out client/public/fonts)
client/public/fonts/

# Default gateway SQLite database and sidecars
/gateway.sqlite3
/gateway.sqlite3-*

# M1-066: local dev stack runtime state (PIDs, logs, ephemeral secrets, spool)
.dev-stack/
