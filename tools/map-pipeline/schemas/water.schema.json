                      "type": "array"
                    },
                    "minItems": 2,
                    "type": "array"
                  },
                  "type": {
                    "const": "LineString"
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "coordinates": {
                    "items": {
                      "items": {
                        "items": {
                          "maximum": 2048,
                          "minimum": 0,
                          "type": "number"
                        },
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                      },
                      "minItems": 4,
                      "type": "array"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "type": {
                    "const": "Polygon"
                  }
                },
                "required": [
