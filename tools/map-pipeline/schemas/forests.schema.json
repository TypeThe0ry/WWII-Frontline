{
  "$id": "frontline/map-pipeline/forests.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "features": {
      "items": {
        "properties": {
          "geometry": {
            "properties": {
              "coordinates": {
                "items": {
                  "items": {
                    "items": {
                      "maximum": 2048,
                      "minimum": 0,
                      "type": "number"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "minItems": 4,
                  "type": "array"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": {
                "const": "Polygon"
              }
            },
            "required": [
              "type",
              "coordinates"
            ],
            "type": "object"
          },
          "properties": {
            "additionalProperties": false,
            "properties": {
              "_derived": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "_osm_id": {
                "pattern": "^(way|relation)/[0-9]+$",
                "type": "string"
              },
              "density": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "kind": {
                "enum": [
                  "forest",
                  "orchard",
                  "scrub"
                ]
              },
              "species": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "density",
              "species",
              "_osm_id",
              "_derived"
            ],
            "type": "object"
          },
          "type": {
            "const": "Feature"
          }
        },
        "required": [
          "type",
          "properties",
          "geometry"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "type": {
      "const": "FeatureCollection"
    }
  },
  "required": [
    "type",
    "features"
  ],
  "title": "forests.geojson (M1-032)",
  "type": "object"
}
