{
  "name": "@frontline/asset-pipeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Asset pipeline: ingest (license gate), normalize, report (M1-001); later steps extend it.",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "asset-pipeline": "./bin/asset-pipeline.mjs"
  },
  "scripts": {
