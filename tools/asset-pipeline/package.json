    "ajv": "8.20.0",
    "ktx-parse": "2.0.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
