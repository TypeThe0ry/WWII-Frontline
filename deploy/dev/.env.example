# Local dev compose environment variables (example placeholders only — no real credentials).
# Copy to deploy/dev/.env and generate random tokens with: openssl rand -hex 24

GATEWAY_PORT=8080
FRONTLINE_WS_PORT=7000
FRONTLINE_WT_PORT=7001
FRONTLINE_METRICS_PORT=9100
STATIC_PORT=8081

FRONTLINE_MAP=m0
FRONTLINE_MODE=sandbox
FRONTLINE_BOTS=0
FRONTLINE_PUBLIC_ADDR=127.0.0.1

# Generate local-only tokens before running docker compose up:
INTERNAL_API_TOKEN=change-me-local-dev-internal-token
TOKEN_SECRET=change-me-local-dev-session-hmac-key
