# Multi-stage Dockerfile for frontline-server (M1-066)
FROM rust:1.97-slim-bookworm AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/protocol crates/protocol
COPY crates/sim crates/sim
COPY crates/bots crates/bots
COPY crates/server crates/server
COPY crates/sim-wasm/Cargo.toml crates/sim-wasm/Cargo.toml
COPY crates/gateway/Cargo.toml crates/gateway/Cargo.toml
COPY crates/headless-client/Cargo.toml crates/headless-client/Cargo.toml
COPY crates/balance-sim/Cargo.toml crates/balance-sim/Cargo.toml
RUN mkdir -p crates/sim-wasm/src crates/gateway/src crates/headless-client/src crates/balance-sim/src \
    && for d in sim-wasm gateway headless-client balance-sim; do echo "" > "crates/$d/src/lib.rs"; done \
    && cargo build --release --locked -p frontline-server --bin frontline-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /var/lib/frontline frontline
COPY --from=builder /src/target/release/frontline-server /usr/local/bin/frontline-server
USER frontline
WORKDIR /var/lib/frontline
EXPOSE 7000/tcp 7001/udp 9100/tcp
ENTRYPOINT ["/usr/local/bin/frontline-server"]
